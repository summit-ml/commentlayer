{
  "manifest_version": 3,
  "name": "CommentLayer",
  "version": "0.1.0",
  "description": "Drop a pin, leave a note. Private review comments on any website. One click to start, one link to invite.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CommentLayer: toggle on this site",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bridge.js",
        "commentlayer.js"
      ],
      "css": [
        "commentlayer.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://commentlayer.summitml.com/join*",
        "http://localhost:8790/join*"
      ],
      "js": [
        "join.js"
      ],
      "run_at": "document_start"
    }
  ]
}
