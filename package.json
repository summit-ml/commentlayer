{
  "name": "@summitml/commentlayer",
  "version": "0.1.0",
  "description": "Drop-a-pin review comments for any site: a client overlay plus a storage-backed request handler.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/summit-ml/commentlayer.git"
  },
  "homepage": "https://summitml.com/products/open-source",
  "keywords": [
    "review",
    "comments",
    "annotations",
    "feedback",
    "browser-extension",
    "cloudflare-workers"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./sheets": "./src/sheets.ts",
    "./client/*": "./client/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./sheets": {
        "types": "./dist/sheets.d.ts",
        "default": "./dist/sheets.js"
      },
      "./client/*": "./client/*",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "client",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:extension": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p extension",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22",
    "esbuild": "^0.24",
    "typescript": "^5"
  }
}
