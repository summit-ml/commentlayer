{
  "manifest_version": 3,
  "name": "CommentLayer",
  "version": "0.1.0",
  "description": "Drop a pin, leave a note. Review comments on any website, stored wherever you choose.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "CommentLayer: toggle on this site", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["bridge.js", "commentlayer.js"], "css": ["commentlayer.css"], "run_at": "document_idle" }
  ]
}
